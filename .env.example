# Neon Serverless PostgreSQL Database Connection
# Application queries use the connection pooler
DATABASE_URL="postgresql://user:password@ep-cool-pooler.us-east-2.aws.neon.tech/cinebook?sslmode=require"
# Migrations use the direct connection
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-cool.us-east-2.aws.neon.tech/cinebook?sslmode=require"

# Authentication
JWT_SECRET="cinebook_super_secret_jwt_key_min_32_chars_long_change_in_prod"

# Cron Job Protection
CRON_SECRET="cinebook_cron_secret_token_12345"

# Stripe Test Mode Credentials
STRIPE_SECRET_KEY="sk_test_mock_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_mock_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_mock_webhook_secret"

# Vercel Blob (Optional for movie assets)
BLOB_READ_WRITE_TOKEN=""

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
